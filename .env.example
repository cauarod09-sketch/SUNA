# Copie para .env e preencha. NUNCA coloque a chave service_role aqui (ela fica só no servidor).

# Modo demonstração: tudo fica no navegador, sem servidor. Use só para testar. NÃO publicar assim.
VITE_DEMO_MODE=false

# Produção: chaves PÚBLICAS do projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SUNA_CUSTOM_GPT_URL — link do GPT personalizado (personal e nutri virtual). Ex.: https://chatgpt.com/g/g-XXXX
# Vazio = usa o link padrão definido em src/config.ts.
VITE_SUNA_CUSTOM_GPT_URL=
